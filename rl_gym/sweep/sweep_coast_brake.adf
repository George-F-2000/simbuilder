MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$-----------------------------------------------------------------------MANEUVERS_LIST
$----------------------------------------------------------------------MANEUVERS_LIST
[MANEUVERS_LIST]
{name            simulation_time      h_max           print_interval }
'MANEUVER_1'     5                    0.01            0.01            
'MANEUVER_2'     40                   0.01            0.01            
'MANEUVER_3'     10                   0.01            0.01            
'MANEUVER_4'     150                  0.01            0.01            
