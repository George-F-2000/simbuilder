'MANEUVER_10'     8                    0.01            0.01            
'MANEUVER_11'     30                   0.01            0.01            
'MANEUVER_12'     4                    0.01            0.01            
$--------------------------------------------------------------------------MANEUVER_1
$ hold
[MANEUVER_1]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_1             NONE                     
 BRAKE                     OL_BRAKE_1                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
$-----------------------------------------------------------------------OL_THROTTLE_1
[OL_THROTTLE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------OL_BRAKE_1
[OL_BRAKE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0.35
$--------------------------------------------------------------------------MANEUVER_2
$ launch 60% to 100
[MANEUVER_2]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_2             NONE                     
 BRAKE                     OL_BRAKE_2                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
(END_CONDITIONS) 
{SIGNAL     GROUP      ABS        OPERATOR   VALUE      TOLERANCE  WATCH_TIME}
 LONG_VEL   0          Y          GT         27777.778  416.667    0.001     
$-----------------------------------------------------------------------OL_THROTTLE_2
[OL_THROTTLE_2]
