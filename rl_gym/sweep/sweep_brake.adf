$------------------------------------------------------------------------ALTAIR_HEADER
[ALTAIR_HEADER]
FILE_TYPE    = 'ADF'
FILE_VERSION = 2.0
FILE_FORMAT  = 'ASCII'
$ Scenario: sweep_brake - AVL-Drive sweep event (generated by sweep_events.py)
$--------------------------------------------------------------------------------UNITS
[UNITS]
(BASE)
{ length  force         angle           mass     time }
  'mm'   'newton'      'radians'        'kg'    'sec'
$---------------------------------------------------------------------------VEHICLE_IC
[VEHICLE_INITIAL_CONDITIONS]
VX0               = 10
VY0               = 0.0
VZ0               = 0.0
ENGINE_INIT_SPEED = 300
$-----------------------------------------------------------------------STEER_STANDARD
[STEER_STANDARD]
MAX_VALUE            = 9.4248
MIN_VALUE            = -9.4248
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$--------------------------------------------------------------------THROTTLE_STANDARD
[THROTTLE_STANDARD]
MAX_VALUE            = 1
MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$-----------------------------------------------------------------------BRAKE_STANDARD
[BRAKE_STANDARD]
MAX_VALUE            = 1
MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$------------------------------------------------------------------------GEAR_STANDARD
[GEAR_STANDARD]
MAX_VALUE            = 6
MIN_VALUE            = 1
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 1
$----------------------------------------------------------------------CLUTCH_STANDARD
[CLUTCH_STANDARD]
MAX_VALUE            = 1
MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$-----------------------------------------------------------------------MANEUVERS_LIST
$----------------------------------------------------------------------MANEUVERS_LIST
[MANEUVERS_LIST]
{name            simulation_time      h_max           print_interval }
'MANEUVER_1'     5                    0.001           0.01            
'MANEUVER_2'     3                    0.001           0.01            
'MANEUVER_3'     25                   0.01            0.01            
'MANEUVER_4'     8                    0.01            0.01            
'MANEUVER_5'     30                   0.001           0.01            
$--------------------------------------------------------------------------MANEUVER_1
$ hold (brake 0.35)
[MANEUVER_1]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_1             NONE                     
 BRAKE                     OL_BRAKE_1                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
$-----------------------------------------------------------------------OL_THROTTLE_1
[OL_THROTTLE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------OL_BRAKE_1
[OL_BRAKE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0.35
$--------------------------------------------------------------------------MANEUVER_2
$ launch 40% to 50 (start, 1 ms)
[MANEUVER_2]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_2             NONE                     
 BRAKE                     OL_BRAKE_2                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
$-----------------------------------------------------------------------OL_THROTTLE_2
[OL_THROTTLE_2]
TAG                    = 'OPENLOOP'
TYPE                   = 'EXPRESSION'
EXPRESSION             = 'STEP({%TIME},1,0,1.3,0.4000)'
SIGNAL_CHANNEL         = 0
$--------------------------------------------------------------------------OL_BRAKE_2
[OL_BRAKE_2]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------MANEUVER_3
$ launch 40% to 50 (run)
[MANEUVER_3]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_3             NONE                     
 BRAKE                     OL_BRAKE_3                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
(END_CONDITIONS) 
{SIGNAL     GROUP      ABS        OPERATOR   VALUE      TOLERANCE  WATCH_TIME}
 LONG_VEL   0          Y          GT         13888.889  694.444    0.001     
$-----------------------------------------------------------------------OL_THROTTLE_3
[OL_THROTTLE_3]
TAG                    = 'OPENLOOP'
TYPE                   = 'EXPRESSION'
EXPRESSION             = 'STEP({%TIME},0,{THROTTLE_0},0.1,0.4000)'
SIGNAL_CHANNEL         = 0
$--------------------------------------------------------------------------OL_BRAKE_3
[OL_BRAKE_3]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------MANEUVER_4
$ cruise 50 km/h at p_eq 27.9%
[MANEUVER_4]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_4             NONE                     
 BRAKE                     OL_BRAKE_4                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
$-----------------------------------------------------------------------OL_THROTTLE_4
[OL_THROTTLE_4]
TAG                    = 'OPENLOOP'
TYPE                   = 'EXPRESSION'
EXPRESSION             = 'STEP({%TIME},0,{THROTTLE_0},0.5,0.2786)'
SIGNAL_CHANNEL         = 0
$--------------------------------------------------------------------------OL_BRAKE_4
[OL_BRAKE_4]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------MANEUVER_5
$ brake stop 0.40
[MANEUVER_5]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_5             NONE                     
 BRAKE                     OL_BRAKE_5                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
(END_CONDITIONS) 
{SIGNAL     GROUP      ABS        OPERATOR   VALUE      TOLERANCE  WATCH_TIME}
 LONG_VEL   0          Y          LT         555.556    416.667    0.001     
$-----------------------------------------------------------------------OL_THROTTLE_5
[OL_THROTTLE_5]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------OL_BRAKE_5
[OL_BRAKE_5]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0.4
$-----------------------------------------------------------------------------OL_STEER
[OL_STEER]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$-----------------------------------------------------------------%GEAR_CLUTCH_CONTROL
$Used in case of models with IC Engine 
[GEAR_CLUTCH_CONTROL] 
TAG = 'ENGINE_SPEED'  
(GEAR_SHIFT_MAP)      
{G   US      DS      CT      CRT     TFD     TFT     CFT     TRD     TRT}    
 1   650     125     0.45    0.05    0.1     0.1     0.05    0.05    0.05   
 2   650     125     0.45    0.05    0.1     0.1     0.05    0.05    0.05   
 3   650     125     0.45    0.05    0.1     0.1     0.05    0.05    0.05   
 4   650     125     0.45    0.05    0.1     0.1     0.05    0.05    0.05   
 5   650     125     0.45    0.05    0.1     0.1     0.05    0.05    0.05   
