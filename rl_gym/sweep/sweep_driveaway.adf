$--------------------------------------------------------------------------MANEUVER_1
$ hold (brake 0.35)
[MANEUVER_1]
TASK = 'STANDARD'
(CONTROLLERS)
{DRIVER_SIGNAL             PRIMARY_CONTROLLER        ADDITIONAL_CONTROLLER    }
 STEER                     OL_STEER                  NONE                     
 THROTTLE                  OL_THROTTLE_1             NONE                     
 BRAKE                     OL_BRAKE_1                NONE                     
 GEAR                      GEAR_CLUTCH_CONTROL       NONE                     
 CLUTCH                    GEAR_CLUTCH_CONTROL       NONE                     
$-----------------------------------------------------------------------OL_THROTTLE_1
[OL_THROTTLE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0
$--------------------------------------------------------------------------OL_BRAKE_1
[OL_BRAKE_1]
TAG                    = 'OPENLOOP'
TYPE                   = 'CONSTANT'
VALUE                  = 0.35
