$------------------------------------------------------------------------ALTAIR_HEADER
[ALTAIR_HEADER]
FILE_TYPE    = 'ADF'
FILE_VERSION = 2.0
FILE_FORMAT  = 'ASCII'
$ Scenario: sweep_driveaway - AVL-Drive sweep event (generated by sweep_events.py)
$--------------------------------------------------------------------------------UNITS
[UNITS]
(BASE)
{ length  force         angle           mass     time }
  'mm'   'newton'      'radians'        'kg'    'sec'
$---------------------------------------------------------------------------VEHICLE_IC
[VEHICLE_INITIAL_CONDITIONS]
VX0               = 10
VY0               = 0.0
VZ0               = 0.0
ENGINE_INIT_SPEED = 300
$-----------------------------------------------------------------------STEER_STANDARD
[STEER_STANDARD]
MAX_VALUE            = 9.4248
MIN_VALUE            = -9.4248
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$--------------------------------------------------------------------THROTTLE_STANDARD
[THROTTLE_STANDARD]
MAX_VALUE            = 1
MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$-----------------------------------------------------------------------BRAKE_STANDARD
[BRAKE_STANDARD]
MAX_VALUE            = 1
MIN_VALUE            = 0
SMOOTHING_FREQUENCY  = 10
INITIAL_VALUE        = 0
$------------------------------------------------------------------------GEAR_STANDARD
[GEAR_STANDARD]
